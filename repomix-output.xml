.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.product-info strong {
  font-size: 16px;
  color: var(--text-dark);
}

.product-price {
  font-size: 15px;
  font-weight: 800;
  color: var(--success);
}

.product-stock {
  font-size: 11px;
  background: #f1f5f9;
  color: var(--text-medium);
  padding: 3px 8px;
  border-radius: 20px;
  display: inline-block;
  width: fit-content;
  font-weight: 600;
