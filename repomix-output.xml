  --warning: #f59e0b;
  --success: #16a34a;
  --text-dark: #1e293b;
  --text-medium: #475569;
  --text-light: #94a3b8;
  --bg-card: #ffffff;
  --bg-page: #f8fafc;
  --border: #e2e8f0;
  --radius: 16px;
}

