  border: 1.5px solid var(--danger);
  color: var(--danger);
  border-radius: 10px;
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
  transition: all 0.2s;
}

.btn-remove:hover { background: var(--danger); color: #fff; }

/* === BOTONES DEL FORMULARIO === */
