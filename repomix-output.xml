.file-upload-label:hover { background: var(--primary-hover); }

.file-input-hidden { display: none; }
.file-name { font-size: 12px; color: var(--text-light); }

.preview-container {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 8px;
  padding: 12px;
  background: #fff;
  border-radius: 12px;
  border: 1px solid var(--border);
